{
  "name": "tekmesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build"
  },
  "dependencies": {
